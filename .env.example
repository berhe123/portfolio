# Copy built frontend into the nginx image via compose override if needed.
# Default compose mounts only nginx.conf; for local static serving use:
#   npm run build && npx serve dist
NODE_ENV=production
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Portfolio (Vite) — copy to .env.local for local dev; set in Vercel → Environment Variables
# Google Drive: upload CV → Share → Anyone with the link (Viewer) → copy the /view?usp=sharing URL
# VITE_CV_URL=https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=sharing
